# Token du BOT de ton application Discord dédiée (Developer Portal > Bot > Reset Token)
# Ne jamais utiliser un token de compte utilisateur Discord ici.
DISCORD_BOT_TOKEN=

# ID du serveur Discord cible (clic droit sur le serveur > Copier l'ID, mode développeur activé)
DISCORD_GUILD_ID=

# --- Optionnel : module de veille / actualités automatisée (config/news_sources.yml) ---
# Clé API Gemini gratuite (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optionnel, défaut : gemini-3.6-flash
GEMINI_MODEL=
# Nom du serveur à mentionner dans le prompt de résumé
SERVER_NAME=
# Thèmes acceptés pour le tri des actualités (libre, en français)
NEWS_TOPICS=
# Doivent correspondre aux clés utilisées dans config/channels.yml / config/roles.yml
NEWS_CHANNEL_KEY=
NEWS_ROLE_KEY=
# Heure et fuseau de publication quotidienne (défauts : 12 / Europe/Paris)
NEWS_HOUR=
NEWS_TIMEZONE=
